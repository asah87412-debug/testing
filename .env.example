PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/suvyatra
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
# Email OTP (registration verification + password reset) via Gmail SMTP.
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password: Google Account → Security → App passwords → Mail.
# 3. Paste the 16-char app password below (no spaces). Never commit real .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=SuvYatra
# Google Sign-In (ID tokens are verified against these audiences).
# Get these from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
CHATBOT_API_URL=http://127.0.0.1:8000
CHATBOT_ADMIN_API_KEY=
